# ─────────────────────────────────────────────────────────────
# @maker/database — copy to packages/database/.env
# DATABASE_URL must match Apps/api/.env
# ─────────────────────────────────────────────────────────────

DATABASE_URL=postgresql://maker:maker@127.0.0.1:5432/maker?schema=public

# Must be the same value as Apps/api/.env (AES-256-GCM bot-token encryption)
BOT_TOKEN_ENCRYPTION_KEY=change-me
