# ─────────────────────────────────────────────────────────────
# Maker dashboard (Next.js) — copy to Apps/web/.env.local
# ─────────────────────────────────────────────────────────────

# Browser calls the same origin; Next proxies /api/* to INTERNAL_API_ORIGIN.
NEXT_PUBLIC_API_URL=/api
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Port used by scripts/start-standalone.js (production)
WEB_PORT=3000

# Nest API origin used by the /api proxy at request time
INTERNAL_API_ORIGIN=http://127.0.0.1:4000

# Never expose these first path segments through the dashboard origin
API_PROXY_BLOCKED_PREFIXES=internal,partner
