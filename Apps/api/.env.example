# ─────────────────────────────────────────────────────────────
# Maker API (NestJS) — copy to Apps/api/.env and fill in values.
# Never commit the real .env file.
# ─────────────────────────────────────────────────────────────

# Runtime
NODE_ENV=development
PORT=4000
MAKER_ROOT=../..

# PostgreSQL (SSOT)
DATABASE_URL=postgresql://maker:maker@127.0.0.1:5432/maker?schema=public
REDIS_URL=redis://127.0.0.1:6379

# Data plane flags
DATA_WRITE_MODE=postgres
DATA_READ_SOURCE=postgres
DATA_SHADOW_COMPARE=false
DATA_SHADOW_SAMPLE_RATE=0
DATA_MISMATCH_LOG_SAMPLE_RATE=0
DATA_MISMATCH_ALERT_THRESHOLD=50
DATA_MISMATCH_ALERT_WINDOW_MS=300000

# Security — generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-me
BOT_TOKEN_ENCRYPTION_KEY=change-me
PROVISION_API_KEY=change-me
BOT_INTERNAL_API_KEY=change-me
TOTP_ISSUER=Maker

# Discord OAuth
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=http://localhost:4000/api/auth/discord/callback

# Public URLs / CORS
DASHBOARD_PUBLIC_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
INTERNAL_API_URL=http://127.0.0.1:4000/api
USE_BOT_DATA_API=true

# SMTP (2FA e-mail codes). Leave empty to log codes to console in dev.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Partner API (optional tuning)
PARTNER_HMAC_MAX_SKEW_SEC=300
PARTNER_RATE_LIMIT_PER_MIN=60
PARTNER_MAX_DURATION_DAYS=3650
PARTNER_PENDING_STALE_MS=86400000

# Legacy MongoDB import scripts only (not used at runtime)
MONGODB_URI=
