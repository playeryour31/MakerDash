{
  "name": "maker",
  "version": "1.0.0",
  "private": true,
  "description": "Main bot + Maker customer bots + Apps dashboard",
  "main": "index.js",
  "workspaces": [
    "Apps/web",
    "Apps/api",
    "Apps/bot",
    "packages/database",
    "packages/queue"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "start": "turbo run start",
    "start:bot": "npm run start --workspace=@maker/bot",
    "start:api": "npm run start --workspace=@maker/api",
    "start:web": "npm run start --workspace=@maker/web",
    "build": "turbo run build",
    "test": "npm run build --workspace=@maker/database --silent && node --test",
    "bot": "node scripts/run-bot.js",
    "api:dev": "npm run start:dev --workspace=@maker/api",
    "web:dev": "npm run dev --workspace=@maker/web",
    "db:generate": "npm run generate --workspace=@maker/database",
    "db:migrate": "npm run migrate:dev --workspace=@maker/database",
    "db:migrate:deploy": "npm run migrate:deploy --workspace=@maker/database",
    "db:import:phase1": "npm run import:phase1 --workspace=@maker/database",
    "db:import:phase2": "npm run import:phase2 --workspace=@maker/database",
    "db:import:phase3": "npm run import:phase3 --workspace=@maker/database",
    "db:import:blacklist": "npm run import:blacklist --workspace=@maker/database",
    "db:up": "docker compose up -d postgres redis",
    "queue:build": "npm run build --workspace=@maker/queue",
    "scan:secrets": "node scripts/scan-secrets.js",
    "scan:secrets:all": "node scripts/scan-secrets.js --all",
    "preflight": "node scripts/preflight.js",
    "metrics": "node scripts/metrics.js",
    "metrics:baseline": "node scripts/metrics.js --baseline",
    "lint": "eslint . --max-warnings 68",
    "format": "prettier --write \"scripts/**/*.js\" \"packages/**/*.ts\"",
    "format:check": "prettier --check \"scripts/**/*.js\" \"packages/**/*.ts\"",
    "verify": "npm run lint && npm run format:check && npm test && npm run preflight && npm run scan:secrets && npm run metrics:baseline",
    "db:import:tokens": "node scripts/import-legacy-token-pools.js",
    "db:import:tokens:apply": "node scripts/import-legacy-token-pools.js --apply"
  },
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@discordjs/voice": "^0.19.2",
    "@snazzah/davey": "^0.1.12",
    "archiver": "^7.0.1",
    "axios": "^1.7.9",
    "body-parser": "^1.20.2",
    "canvas": "^3.1.0",
    "chalk": "^4.1.2",
    "cookie-parser": "^1.4.6",
    "discord-giveaways": "^6.0.1",
    "discord-html-transcripts": "^3.1.3",
    "discord-inviter": "^0.9.3",
    "discord-oauth2": "^2.11.0",
    "discord.js": "^14.16.3",
    "dotenv": "^16.4.7",
    "ejs": "^3.1.9",
    "express": "^4.18.2",
    "ffmpeg-static": "^5.3.0",
    "is-image-url": "^1.1.8",
    "libsodium-wrappers": "^0.8.4",
    "moment-timezone": "^0.5.43",
    "ms": "^2.1.3",
    "node-fetch": "^2.6.5",
    "opusscript": "^0.0.8",
    "play-dl": "^1.9.7",
    "st.db": "^6.0.1",
    "tweetnacl": "^1.0.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@next/eslint-plugin-next": "^15.5.29",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.5.0",
    "prettier": "^3.10.1",
    "turbo": "^2.11.5",
    "typescript-eslint": "^8.72.2"
  },
  "packageManager": "npm@11.16.0",
  "allowScripts": {
    "@prisma/client@6.19.3": true,
    "@prisma/engines@6.19.3": true,
    "prisma@6.19.3": true,
    "esbuild@0.28.2": true,
    "ffmpeg-static@5.3.0": true,
    "msgpackr-extract@3.0.7": true,
    "spawn-sync@1.0.15": true,
    "@nestjs/core@10.4.22": true,
    "canvas@3.2.3": true,
    "canvas@2.11.2": true
  }
}
